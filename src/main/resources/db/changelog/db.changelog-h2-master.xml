    <!-- H2-compatible replacement for 018-hard-delete-channels:
         H2 does not support DROP + ADD CONSTRAINT in a single ALTER TABLE statement. -->
    <changeSet id="018-hard-delete-channels" author="tubereturns">
        <sql>ALTER TABLE channel_processing_notifications DROP CONSTRAINT IF EXISTS channel_processing_notifications_channel_id_fkey</sql>
        <sql>ALTER TABLE channel_processing_notifications ADD CONSTRAINT channel_processing_notifications_channel_id_fkey FOREIGN KEY (channel_id) REFERENCES channels (id) ON DELETE CASCADE</sql>
        <sql>ALTER TABLE channels DROP COLUMN IF EXISTS deleted_at</sql>
    </changeSet>

